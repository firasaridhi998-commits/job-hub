# ---------- Access gate (REQUIRED in production) ----------
# Shared passcode friends type to enter the site. Pick a long random value.
APP_ACCESS_CODE=
# Optional: separate secret used to sign session cookies (recommended). e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# ---------- AI providers (all optional; the app works without them) ----------
# Which provider to try first: gemini | groq | openrouter
AI_PRIMARY_PROVIDER=gemini
# Comma-separated fallback order, e.g. groq,openrouter (only configured providers are used)
AI_FALLBACK_PROVIDERS=groq,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model IDs change often. Check each provider's current docs before relying on these defaults.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------- Job search (optional until you want real listings) ----------
# jsearch (RapidAPI) or adzuna
JOB_SEARCH_PROVIDER=jsearch
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna only works per supported country; two-letter code, e.g. gb, us, fr, de
ADZUNA_COUNTRY=gb
